{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-chess.invalid/contracts/legacy-backup-v2.schema.json",
  "title": "Canonical JSON backup v2",
  "description": "Contains string-serialized match and history snapshots. JSON Schema does NOT validate inner chess moves; previewBackup/restoreGame must validate them at runtime.",
  "type": "object",
  "required": [
    "version",
    "match",
    "history",
    "progress"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "match": {
      "type": [
        "string",
        "null"
      ]
    },
    "history": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "outcome",
          "snapshot"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "snapshot": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "progress": {
      "$ref": "legacy-progress-events-v1.schema.json"
    }
  },
  "additionalProperties": false
}
