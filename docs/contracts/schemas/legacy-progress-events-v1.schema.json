{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-chess.invalid/contracts/legacy-progress-events-v1.schema.json",
  "title": "Local-only progression journal v1",
  "description": "Derived immutable legacy ID is kind:exerciseId (not stored). ID uniqueness is checked by readProgress, not uniqueItems semantics alone.",
  "type": "object",
  "required": [
    "version",
    "events"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "events": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "exerciseId"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "lesson",
                  "puzzle"
                ]
              },
              "exerciseId": {
                "type": "string",
                "pattern": "^(?!daily-)[a-z0-9][a-z0-9-]{0,79}$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "kind",
              "exerciseId"
            ],
            "properties": {
              "kind": {
                "const": "daily"
              },
              "exerciseId": {
                "type": "string",
                "pattern": "^daily-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
