{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-chess.invalid/contracts/proposed-account-link-intent-v1",
  "title": "PROPOSED consent-first client link intent; not an authentication token",
  "description": "Identity subject must be derived exclusively from independently verified provider credential on server; not accepted from this client schema.",
  "type": "object",
  "required": [
    "schemaVersion",
    "intentId",
    "deviceId",
    "action",
    "snapshotRevision",
    "consentVersion",
    "requestedScopes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "intentId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "enum": [
        "preview",
        "confirm"
      ]
    },
    "snapshotRevision": {
      "type": "integer",
      "minimum": 0
    },
    "consentVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "requestedScopes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "profile",
          "progress",
          "match-history",
          "preferences"
        ]
      }
    }
  },
  "additionalProperties": false
}
