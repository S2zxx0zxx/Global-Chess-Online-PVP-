{
  "name": "global-chess-online-pvp",
  "main": "server/cloudflare-worker.js",
  "build": { "command": "node scripts/prepare-worker-solver.js" },
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
